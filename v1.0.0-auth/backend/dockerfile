# ÉTAPE 1: Builder - Pour compiler TypeScript
FROM node:20-alpine AS builder

WORKDIR /app

# Copier les fichiers package
COPY package*.json ./

# Installer TOUTES les dépendances (y compris devDependencies pour TypeScript)
RUN npm ci && npm cache clean --force

# Copier le code source
COPY . .

# Compiler TypeScript
RUN npm run build

# ÉTAPE 2: Production - Image finale légère
FROM node:20-alpine AS production

WORKDIR /app

# Copier package files
COPY package*.json ./

# Installer SEULEMENT les dépendances de production (plus léger et sécurisé)
RUN npm ci --only=production && npm cache clean --force

# Créer utilisateur non-root (sécurité)
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /app

# Copier le build compilé depuis le stage builder
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist

# Copier les fichiers nécessaires
COPY --from=builder --chown=nodejs:nodejs /app/healthcheck.js ./

# Basculer vers utilisateur non-root
USER nodejs

EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node healthcheck.js

CMD ["node", "dist/index.js"]